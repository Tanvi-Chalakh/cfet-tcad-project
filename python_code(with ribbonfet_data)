def load_device_csv(path, is_pfet=False, id_scale=1.0):

    if not os.path.isfile(path):
        raise FileNotFoundError(
            f"Could not find '{path}'. Check the CSV filename in Section 2."
        )

    df = pd.read_csv(path)

    required = {"Vg", "Id"}
    missing = required.difference(df.columns)

    if missing:
        raise ValueError(
            f"'{path}' must contain columns named Vg and Id. "
            f"Missing columns: {sorted(missing)}"
        )

    vg = df["Vg"].to_numpy(dtype=float)

    if is_pfet:
        vg = -vg

    idd = np.abs(df["Id"].to_numpy(dtype=float)) * id_scale

    valid = np.isfinite(vg) & np.isfinite(idd)
    vg, idd = vg[valid], idd[valid]

    order = np.argsort(vg, kind="stable")
    vg, idd = vg[order], idd[order]

    # Keep the last occurrence if the CSV contains duplicate gate voltages.
    _, reverse_indices = np.unique(vg[::-1], return_index=True)

    keep = np.sort(len(vg) - 1 - reverse_indices)

    vg, idd = vg[keep], idd[keep]

    if len(vg) < 3:
        raise ValueError(
            f"'{path}' has fewer than three valid unique Vg points."
        )

    return vg, idd


def vt_linear(vg, idd):
    """Threshold voltage from linear extrapolation at maximum gm."""

    vf = np.linspace(vg.min(), vg.max(), 600)

    current = np.interp(vf, vg, idd)

    gm = np.gradient(current, vf)

    k = int(np.argmax(gm))

    if not np.isfinite(gm[k]) or gm[k] <= 0:
        return np.nan, gm[k]

    return vf[k] - current[k] / gm[k], gm[k]


def vg_at_level(vg, idd, level):

    valid = (idd > 0) & np.isfinite(idd)

    x = vg[valid]
    log_id = np.log10(idd[valid])

    target = np.log10(level)

    if len(log_id) < 2 or not (
        log_id.min() <= target <= log_id.max()
    ):
        return np.nan

    for j in range(len(log_id) - 1):

        if (
            (log_id[j] - target)
            * (log_id[j + 1] - target) <= 0
        ):

            if log_id[j] == log_id[j + 1]:
                continue

            return x[j] + (
                (target - log_id[j]) * (x[j + 1] - x[j])
                / (log_id[j + 1] - log_id[j])
            )

    return np.nan


def ss_avg(vg, idd, lev_lo, lev_hi):

    vg_lo = vg_at_level(vg, idd, lev_lo)
    vg_hi = vg_at_level(vg, idd, lev_hi)

    return 1000.0 * (vg_hi - vg_lo) / (
        np.log10(lev_hi) - np.log10(lev_lo)
    )


def ss_min(vg, idd, lev_lo, lev_hi):

    mask = (
        (idd >= lev_lo)
        & (idd <= lev_hi)
        & (idd > 0)
    )

    if mask.sum() < 3:
        return np.nan

    slope = np.gradient(
        np.log10(idd[mask]),
        vg[mask]
    )

    positive_slope = slope[slope > 0]

    if len(positive_slope) == 0:
        return np.nan

    return 1000.0 / np.max(positive_slope)


def id_at(vg, idd, v):

    return float(
        np.exp(
            np.interp(
                v,
                vg,
                np.log(np.maximum(idd, 1e-30))
            )
        )
    )


def mobility(vg, idd, vd, lg_cm, weff_cm, cox, vt,
             vov_fit=(0.05, 0.30)):

    gm = np.gradient(idd, vg)

    mu_fe = gm * lg_cm / (weff_cm * cox * vd)

    ns = cox * (vg - vt) / Q

    valid = (
        (vg > vt + 0.02)
        & (gm > 0)
        & np.isfinite(mu_fe)
    )

    if valid.sum() == 0:
        return None

    peak_index = np.argmax(
        np.where(valid, mu_fe, -np.inf)
    )

    fit_mask = (
        (vg >= vt + vov_fit[0])
        & (vg <= vt + vov_fit[1])
        & (gm > 0)
    )

    mu0 = np.nan

    if fit_mask.sum() >= 4:

        y = idd[fit_mask] / np.sqrt(gm[fit_mask])

        slope = np.polyfit(
            vg[fit_mask],
            y,
            1
        )[0]

        mu0 = (
            slope**2 * lg_cm
            / (cox * weff_cm * vd)
        )

    return {
        "vg": vg,
        "mu_fe": mu_fe,
        "ns": ns,
        "mask": valid,
        "mu_peak": mu_fe[peak_index],
        "ns_peak": ns[peak_index],
        "vg_peak": vg[peak_index],
        "mu0": mu0,
    }


def prepare_simulation_curve(path, dev):

    vg, idd = load_device_csv(
        path,
        is_pfet=(dev == "p"),
        id_scale=ID_SCALE
    )

    vt, gm_max = vt_linear(vg, idd)

    if not np.isfinite(vt):
        raise ValueError(
            f"Could not extract a valid Vt from '{path}'."
        )

    norm = id_at(
        vg,
        idd,
        vt + VOV_NORM
    )

    return {
        "vg": vg,
        "id": idd,
        "vt": vt,
        "gm_max": gm_max,
        "norm": norm,
    }


def prepare_paper_curve(dev, vd_tag):
    """Get the Tsi=5.5 nm Figure 10 curve and normalise arbitrary Id."""

    key = (dev.upper(), PAPER_TSI, vd_tag)

    if key not in FIG10:
        raise KeyError(
            f"Paper Figure 10 data does not contain key {key}."
        )

    vg, log_id = FIG10[key]

    vg = np.asarray(vg, dtype=float)

    idd = 10.0 ** np.asarray(log_id, dtype=float)

    order = np.argsort(vg, kind="stable")

    vg, idd = vg[order], idd[order]

    vt, _ = vt_linear(vg, idd)

    if not np.isfinite(vt):
        raise ValueError(
            f"Could not extract paper Vt for {key}."
        )

    norm = id_at(
        vg,
        idd,
        vt + VOV_NORM
    )

    return {
        "vg": vg,
        "id": idd,
        "vt": vt,
        "norm": norm
    }


